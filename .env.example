# Pulled automatically via `vercel env pull .env.local` — do not fill in real values here.
# This file documents what's needed; real secrets live only in Vercel/Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct (non-pooled) connection, used for applying migrations via psql.
POSTGRES_URL_NON_POOLING=
